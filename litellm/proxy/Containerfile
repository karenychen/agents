# litellm/proxy/Containerfile
ARG ALPINE_IMAGE="alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b"
FROM ${ALPINE_IMAGE}

ARG TINYPROXY_VERSION="1.11.3-r0"
# The tinyproxy package already creates a system "tinyproxy" user/group, so we
# add a distinct non-root account (numeric UID/GID 10001) to run as instead.
RUN apk add --no-cache "tinyproxy=${TINYPROXY_VERSION}" \
 && addgroup -g 10001 egressproxy \
 && adduser -D -H -u 10001 -G egressproxy egressproxy

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY allowlist.filter /etc/tinyproxy/allowlist.filter

USER 10001
EXPOSE 8888
# Foreground (-d), explicit config.
ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
