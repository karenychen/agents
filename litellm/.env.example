# litellm/.env.example
# Copy to .env and adjust. .env is gitignored. Contains no secrets.

# Pinned images.
# LiteLLM v1.90.0 was the latest non-prerelease release when refreshed.
LITELLM_IMAGE_AMD64="ghcr.io/berriai/litellm@sha256:fd1126dd846de3dbbcf21a0e206ef773bed6ca62baccdc9ea8a05cb0c2cbf8ec"
LITELLM_IMAGE_ARM64="ghcr.io/berriai/litellm@sha256:7c7566dbe565b57245caa4a21694de8a6d120f2c4bfb2b7ac9298137ceb3e285"
# Optional manual override, for example a locally mirrored image.
LITELLM_IMAGE=""

# Alpine 3.24.1 multi-arch index digest.
ALPINE_IMAGE="docker.io/library/alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b"
TINYPROXY_VERSION="1.11.3-r0"

# Local-only published port for clients
LISTEN_ADDR="127.0.0.1"
LISTEN_PORT="4000"

# Container internals
CONTAINER_HOME="/home/litellm"
# keep-id runs LiteLLM as the calling user's unprivileged UID, which keeps the
# named auth volume writable on both Linux and Podman Machine hosts.
LITELLM_UID="keep-id"
PROXY_UID="10001"
EGRESS_PORT="8888"
LITELLM_CONTAINER="litellm-copilot"
PROXY_CONTAINER="litellm-copilot-egress"
INTERNAL_NETWORK="litellm_internal"
EGRESS_NETWORK="litellm_egress"
AUTH_VOLUME="litellm_copilot_auth"
MASTER_KEY_SECRET="litellm_master_key"
MASTER_KEY_FILE="${HOME}/.config/litellm/master_key"

# Resource ceilings. Tighten further after a local load test if desired.
MIN_PODMAN_MACHINE_MEMORY_MB="4096"
LITELLM_MEMORY="3072m"
LITELLM_CPUS="1"
PROXY_MEMORY="128m"
PROXY_CPUS="0.25"
